# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# Ambientes virtuais
.env/
.venv/
venv/

# Banco e artefatos gerados
data/pregoes.db
data/pregoes.db-shm
data/pregoes.db-wal
data/exports/*.xlsx

# Seed do banco para instalação nova (cópia do banco real → dados privados
# do cliente: catálogo, preços, aprendizado — NUNCA versionar)
data/pregoes_seed.db
data/pregoes_seed.db-shm
data/pregoes_seed.db-wal

# Backups do banco e log de runtime (gerados na máquina do cliente)
data/backups/
data/pregoes.log
data/pregoes.log.*
data/console.log
# Rascunhos (autosave) dos pregões em andamento — dados do cliente
data/rascunhos/
data/rascunho.pkl

# Relatórios de diagnóstico da busca (gerados em runtime, podem conter
# descrições de editais reais do cliente — não versionar)
data/diagnostico/

# Controle de versão do algoritmo de busca (runtime — invalida cache)
data/.busca_versao

# Catálogo histórico importado (planilhas do cliente — dados privados)
data/historico/

# Editais reais do cliente — nunca versionar (dados privados, podem ser grandes).
# Exceção: o PDF sintético usado em tests/test_mvp.py fica versionado.
data/editais/*.pdf
!data/editais/araruna_teste_sintetico.pdf

# Credenciais de fornecedores (Q8) — NUNCA versionar
data/credenciais.json

# Empacotamento PyInstaller (P1.1) — saída de build, gerada no Windows
/build/
/dist/
/.build_env/
*.exe

# OS
.DS_Store
*.swp
*.bak
data/validacao/
data/historico_REMOVIDO_*/
/Users/pabloporto/Downloads/Formação de preços
data/historico/*.xlsx
