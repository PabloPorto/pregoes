# Interface do Pregões no servidor (Starlette) — a de produção desde 2026-11-17,
# no lugar do Streamlit (pregoes.service, desligado e mantido como plano de volta).
# Escuta só em 127.0.0.1:8501; quem publica é o túnel (pregoes-tunel).
# Log: journalctl -u pregoes-web -f · Voltar ao Streamlit: ver INTERFACE_WEB.md.
[Unit]
Description=Pregoes (interface web)
After=network-online.target
Wants=network-online.target

[Service]
User=pregoes
WorkingDirectory=/home/pregoes/pregoes
Environment=PREGOES_SERVIDOR=1
Environment=PREGOES_WEB_PORTA=8501
ExecStart=/home/pregoes/pregoes/.venv/bin/python run_web.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
