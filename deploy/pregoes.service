# Interface ANTIGA do Pregões (Streamlit). DESLIGADA desde 2026-11-17: a de
# produção é pregoes-web.service, na mesma porta (8501) — as duas não sobem
# juntas. Fica aqui só como plano de volta (ver INTERFACE_WEB.md).
[Unit]
Description=Pregoes (Streamlit)
After=network-online.target
Wants=network-online.target

[Service]
User=pregoes
WorkingDirectory=/home/pregoes/pregoes
Environment=PREGOES_SERVIDOR=1
ExecStart=/home/pregoes/pregoes/.venv/bin/python run_app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
