#!/usr/bin/env bash
# Hook de pre-push: roda a suíte ANTES de deixar o push sair. Bloqueia push que
# quebre algo (a rede de regressão + caracterização). Pular (emergência):
#   git push --no-verify
set -e
cd "$(git rev-parse --show-toplevel)"
echo "[pre-push] rodando a suíte de testes antes do push..."
if [ -f .env/bin/activate ]; then source .env/bin/activate; fi
python -m pytest tests/ -q
echo "[pre-push] suíte verde — push liberado."
